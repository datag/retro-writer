# Contact address of the site operator. Rendered as a mailto link in the menu
# (F1). If the variable is not set, the contact link is hidden.
APP_OPERATOR_MAIL=operator@example.com

# Base URL of the privacy policy. The menu links to the English section of it
# via the anchor #en, so that anchor must exist on the target page. If the
# variable is not set, the link is hidden.
APP_PRIVACY_POLICY_URL=https://www.example.com/privacy
